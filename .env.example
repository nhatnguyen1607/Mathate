PORT=8081
# Firebase web configuration. VITE_* values are public in the browser bundle.
# Supply these at build time in the hosting environment too.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only settings. Never prefix Gemini or service-account secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_PROJECT_ID=mathate-8cd62
# Download a service account for Mathate only, or use Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/mathate-service-account.json
# Alternatively set FIREBASE_SERVICE_ACCOUNT to the service account JSON.
# TTS is independent of Firebase Admin. Reuse Math-AI's Cloud TTS account if authorized.
# TTS_APPLICATION_CREDENTIALS=C:/secure/tts-service-account.json
# Or set TTS_SERVICE_ACCOUNT to the service account JSON.
# Also accepts Math-AI's GOOGLE_SERVICE_ACCOUNT_JSON or EMAIL/PRIVATE_KEY env format.
# Missing Cloud TTS config shows an error; never falls back to an English device voice.
DEMO_MODE=true

# Cloudinary server-only URL for signed avatar uploads.
CLOUDINARY_URL=
